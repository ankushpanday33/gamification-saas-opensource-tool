{
  "name": "gamify-saas",
  "version": "1.0.0",
  "description": "Gamification-as-a-Service Platform (like Trophy.so) with authentic reverse-engineered mechanics",
  "main": "server/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "build:arcade": "npm --prefix packages/gh-arcade install && npm --prefix packages/gh-arcade run build",
    "offerkit:up": "docker compose -f offerkit/docker-compose.yml --env-file offerkit/.env up -d",
    "offerkit:down": "docker compose -f offerkit/docker-compose.yml --env-file offerkit/.env down",
    "offerkit:setup": "node scripts/offerkit-setup.js",
    "build:coins": "esbuild packages/coins-streak/browser.tsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --loader:.css=text --define:process.env.NODE_ENV=\\\"production\\\" --external:lottie-web/* --external:@rive-app/canvas --outfile=public/sdk/coins-streak.js",
    "typecheck:coins": "tsc -p packages/coins-streak",
    "build:playkit": "esbuild packages/play-kit/demo/browser.tsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/sdk/play-kit.js",
    "build:flowkit": "esbuild packages/flow-kit/demo/browser.tsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --alias:react-native=react-native-web --define:process.env.NODE_ENV=\\\"production\\\" --define:__DEV__=false --external:react-native-svg --outfile=public/sdk/flow-kit.js"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "0.25.10",
    "motion": "12.23.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-web": "^0.19.13",
    "typescript": "5.9.2",
    "zod": "^3.25.0"
  }
}
